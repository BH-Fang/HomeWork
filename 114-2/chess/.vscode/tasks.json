{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build darkchess project",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\main.c",
                "${workspaceFolder}\\game_logic.c",
                "${workspaceFolder}\\ai.c",
                "${workspaceFolder}\\renderer.c",
                "-o",
                "${workspaceFolder}\\darkchess.exe",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "編譯所有 .c 檔案並輸出為 darkchess.exe"
        }
    ],
    "version": "2.0.0"
}