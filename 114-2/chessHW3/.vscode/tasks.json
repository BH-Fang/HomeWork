{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C (gcc)",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "-lws2_32"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compile current C file with gcc"
    }
  ]
}
